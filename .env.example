# ── App ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://lipabit.com
ALLOWED_ORIGINS=https://lipabit.com,https://www.lipabit.com
NEXT_PUBLIC_API_URL=https://api.lipabit.com/api/v1

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://lipabit:CHANGE_ME@postgres:5432/lipabit
DB_PASSWORD=CHANGE_ME

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_PASSWORD=CHANGE_ME

# ── Auth ───────────────────────────────────────────────────────
JWT_SECRET=GENERATE_WITH_openssl_rand_-hex_64
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=GENERATE_WITH_openssl_rand_-hex_64
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── M-Pesa (Daraja) ────────────────────────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=YOUR_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_CONSUMER_SECRET
MPESA_BUSINESS_SHORT_CODE=174379
MPESA_PASSKEY=YOUR_PASSKEY
MPESA_CALLBACK_BASE_URL=https://api.lipabit.com
MPESA_B2C_INITIATOR_NAME=YOUR_INITIATOR_NAME
MPESA_B2C_SECURITY_CREDENTIAL=YOUR_SECURITY_CREDENTIAL
MPESA_B2C_SHORT_CODE=YOUR_B2C_SHORT_CODE

# ── Bitcoin ────────────────────────────────────────────────────
BITCOIN_NETWORK=mainnet
BITCOIN_RPC_URL=http://localhost:8332
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASSWORD=CHANGE_ME
BITCOIN_WALLET_NAME=lipabit
BITCOIN_MIN_CONFIRMATIONS=3
HOT_WALLET_THRESHOLD_SATS=10000000

# ── Email (Resend — free at resend.com, sign up with GitHub) ───
RESEND_API_KEY=re_YOUR_KEY_FROM_RESEND_COM
EMAIL_FROM=LipaBit <onboarding@resend.dev>

# ── Ethereum ───────────────────────────────────────────────────
ETHEREUM_NETWORK=mainnet
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
ETHEREUM_MNEMONIC=your twelve word mnemonic phrase goes here for hd wallet
ETHEREUM_MIN_CONFIRMATIONS=12

# ── Binance (rate feed) ────────────────────────────────────────
BINANCE_API_KEY=YOUR_BINANCE_KEY
BINANCE_API_SECRET=YOUR_BINANCE_SECRET
